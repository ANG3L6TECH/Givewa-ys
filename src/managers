// src/managers/giveawayManager.js
// Moteur de tirage au sort, vérification dynamique des conditions et reroll automatique
const repo = require('../database/giveawayRepository');

async function evaluateDynamicCondition(guild, userId, condition, stats) {
  let member = null;
  try {
    member = await guild.members.fetch(userId);
  } catch {
    member = null;
  }

  switch (condition.type) {
    case 'server_member': {
      const passed = Boolean(member);
      return {
        passed,
        displayLine: condition.label || 'Membre du serveur'
      };
    }

    case 'min_invites': {
      const required = Number(condition.targetValue) || 1;
      let actualInvites = stats.invites_count || 0;

      try {
        const guildInvites = await guild.invites.fetch();
        const userInvites = guildInvites.filter((inv) => inv.inviter && inv.inviter.id === userId);
        const fetchedUses = userInvites.reduce((acc, inv) => acc + (inv.uses || 0), 0);
        actualInvites = Math.max(actualInvites, fetchedUses);
      } catch {
        // Fallback sur la table SQLite member_stats
      }

      const passed = actualInvites >= required;
      return {
        passed,
        displayLine: condition.label
      };
    }

    case 'min_messages': {
      const required = Number(condition.targetValue) || 1;
      const actualMessages = stats.messages_count || 0;
      const passed = actualMessages >= required;

      let line = condition.label;
      if (line.toLowerCase() === "condition d'activité") {
        line = passed ? "Condition d'activité respectée" : "Condition d'activité non respectée";
      }
      return {
        passed,
        displayLine: line
      };
    }

    case 'min_voice_minutes': {
      const required = Number(condition.targetValue) || 1;
      const actualVoice = stats.voice_minutes || 0;
      const passed = actualVoice >= required;
      return {
        passed,
        displayLine: condition.label
      };
    }

    case 'required_role': {
      const target = String(condition.targetValue).trim();
      const passed = Boolean(
        member &&
          (member.roles.cache.has(target) ||
            member.roles.cache.some((r) => r.name.toLowerCase() === target.toLowerCase()))
      );
      return {
        passed,
        displayLine: condition.label
      };
    }

    case 'min_account_age_days': {
      const requiredDays = Number(condition.targetValue) || 1;
      const createdTimestamp = member?.user?.createdTimestamp || 0;
      const ageDays = Math.floor((Date.now() - createdTimestamp) / (1000 * 60 * 60 * 24));
      const passed = Boolean(member && ageDays >= requiredDays);
      return {
        passed,
        displayLine: condition.label
      };
    }

    case 'custom_check': {
      const key = condition.customKey || condition.label;
      const passed = Boolean(stats.customFlags && stats.customFlags[key]);
      return {
        passed,
        displayLine: condition.label
      };
    }

    default:
      return {
        passed: true,
        displayLine: condition.label
      };
  }
}

async function processGiveawayEnd(client, giveawayId) {
  const giveaway = repo.getGiveawayById(giveawayId);
  if (!giveaway || giveaway.status !== 'ACTIVE') return;

  const guild = await client.guilds.fetch(giveaway.guild_id).catch(() => null);
  if (!guild) return;

  const channel = await guild.channels.fetch(giveaway.channel_id).catch(() => null);
  if (!channel || !channel.isTextBased()) return;

  const disqualified = new Set(giveaway.disqualified || []);
  const validatedWinners = new Set(giveaway.validatedWinners || []);

  while (validatedWinners.size < giveaway.winners_count) {
    const eligiblePool = giveaway.participants.filter(
      (userId) => !disqualified.has(userId) && !validatedWinners.has(userId)
    );

    if (eligiblePool.length === 0) {
      await channel.send(
        `⚠️ **GIVEAWAY TERMINÉ (${giveaway.prize})**\nIl n'y a plus aucun participant éligible respectant les conditions.`
      );
      break;
    }

    const candidateId = eligiblePool[Math.floor(Math.random() * eligiblePool.length)];
    const stats = repo.getMemberStats(guild.id, candidateId);

    const verificationChecks = [];
    for (const condition of giveaway.conditions) {
      const check = await evaluateDynamicCondition(guild, candidateId, condition, stats);
      verificationChecks.push(check);
    }

    const allConditionsMet = verificationChecks.every((c) => c.passed);
    const formattedConditionsList =
      verificationChecks.length > 0
        ? verificationChecks.map((c) => `${c.passed ? '✅' : '❌'} ${c.displayLine}`).join('\n')
        : '✅ Aucune condition restrictive';

    if (!allConditionsMet) {
      disqualified.add(candidateId);
      repo.updateGiveawayState(giveaway.id, {
        disqualified: Array.from(disqualified)
      });

      const failedOutput = [
        '🎉 GIVEAWAY TERMINÉ !',
        '',
        `🏆 Gagnant : <@${candidateId}>`,
        `🎁 Récompense : ${giveaway.prize}`,
        '',
        '📋 VÉRIFICATION DES CONDITIONS',
        '',
        formattedConditionsList,
        '',
        '❌ Le gagnant ne respecte pas toutes les conditions.',
        '',
        '🔄 Nouveau tirage automatique...'
      ].join('\n');

      await channel.send({ content: failedOutput });
      await new Promise((r) => setTimeout(r, 1800));
      continue;
    }

    validatedWinners.add(candidateId);
    repo.updateGiveawayState(giveaway.id, {
      validatedWinners: Array.from(validatedWinners)
    });

    const validatedOutput = [
      '🎉 GAGNANT VALIDÉ !',
      '',
      `🏆 <@${candidateId}>`,
      `🎁 Récompense : ${giveaway.prize}`,
      '',
      '📋 CONDITIONS',
      '',
      formattedConditionsList,
      '',
      '🎁 Toutes les conditions sont respectées.',
      '🏆 Le gagnant est officiellement validé !'
    ].join('\n');

    await channel.send({ content: validatedOutput });
  }

  repo.updateGiveawayState(giveaway.id, {
    status: validatedWinners.size > 0 ? 'COMPLETED' : 'NO_VALID_WINNER',
    disqualified: Array.from(disqualified),
    validatedWinners: Array.from(validatedWinners)
  });
}

function startGiveawayScheduler(client) {
  setInterval(async () => {
    const activeGiveaways = repo.getActiveGiveaways();
    const now = Date.now();
    for (const gw of activeGiveaways) {
      if (now >= gw.ends_at) {
        await processGiveawayEnd(client, gw.id);
      }
    }
  }, 5000);
}

module.exports = {
  processGiveawayEnd,
  startGiveawayScheduler
};
